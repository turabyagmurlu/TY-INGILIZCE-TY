              "VEN-go"
            ],
            [
              "tu",
              "vieni",
              "VYE-ni"
            ],
            [
              "lui / lei / Lei",
              "viene",
              "VYE-ne"
            ],
            [
              "noi",
              "veniamo",
              "ve-NYA-mo"
            ],
            [
              "voi",
